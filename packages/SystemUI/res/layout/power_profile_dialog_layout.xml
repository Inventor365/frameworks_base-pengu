<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
    android:id="@+id/power_profile_dialog_root"
    android:layout_width="@dimen/large_dialog_width"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/power_profile_dialog_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/dialog_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/powerprofile_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@androidprv:color/materialColorOnSurface"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/dialog_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/powerprofile_summary"
            android:textSize="14sp"
            android:textColor="@androidprv:color/materialColorOnSurfaceVariant"
            android:ellipsize="end"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Profiles Scroll Area -->
    <ScrollView
        android:id="@+id/profiles_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls">

        <!-- Profiles Container -->
        <LinearLayout
            android:id="@+id/profiles_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- Bottom Footer Row: HTSR Toggle (Left) & Done Button (Right) -->
    <RelativeLayout
        android:id="@+id/dialog_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/htsr_toggle_button"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/power_profile_htsr_bg_inactive"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/htsr_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_touch_sampling_tile"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/htsr_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/power_chip_htsr_off"
                android:textSize="12sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>

        <Button
            android:id="@+id/done_button"
            style="@style/PowerProfileDialogButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/done_button" />

    </RelativeLayout>

</LinearLayout>
